#!/bin/sh
# Start the graphical installer as root, keeping the live session's display and language.
# (Ubuntu 26.04 uses sudo-rs, which does not support "sudo -E", so pass the variables explicitly.)
# The slideshow is drawn in software so the installer never depends on 3D drivers.
set -- env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
    LANG="${LANG:-C.UTF-8}" LANGUAGE="${LANGUAGE:-}" LC_ALL= \
    QT_QPA_PLATFORMTHEME=gtk3 QT_QUICK_BACKEND=software XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}" \
    calamares "$@"
if sudo -n true 2>/dev/null; then
    exec sudo -n "$@"
fi
exec pkexec "$@"
