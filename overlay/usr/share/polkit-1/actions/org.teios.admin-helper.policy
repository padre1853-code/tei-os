<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Tei OS</vendor>
  <action id="org.teios.admin-helper">
    <description>Change system settings (users, computer name, domain)</description>
    <description xml:lang="ro">Modificarea setărilor de sistem (utilizatori, nume computer, domeniu)</description>
    <message>Authentication is required to change system settings</message>
    <message xml:lang="ro">Este necesară autentificarea pentru a modifica setările de sistem</message>
    <icon_name>tei-control-panel</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/tei/tei-admin-helper</annotate>
  </action>
</policyconfig>
